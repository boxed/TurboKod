<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Info.plist for the native Swift frontend (run_swift.sh wraps the
	     built binary in a TurboKod.app so macOS shows the proper app name
	     + icon in the menu bar and Dock). This is now the only TurboKod
	     app, so it owns the turbokod:// scheme outright (the old alacritty
	     wrapper, se.dryft.turbokod, is gone). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>TurboKod</string>
	<key>CFBundleIconFile</key>
	<string>icon</string>
	<key>CFBundleIdentifier</key>
	<string>se.dryft.turbokod.native</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TurboKod</string>
	<key>CFBundleDisplayName</key>
	<string>TurboKod</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Register the turbokod:// custom URL scheme so links like
	     turbokod://open?file=/path/to/file.py&line=180 route to
	     application(_:open:), which jumps to that file + line. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>se.dryft.turbokod.url</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>turbokod</string>
			</array>
		</dict>
	</array>
	<!-- Declare that the app can open folders, so dropping a project
	     directory onto the Dock icon (or "Open With") routes through
	     application(_:open:) and opens it as a project. Rank Alternate
	     so we don't try to become the system's default folder handler. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>0.0.1</string>
	<key>CFBundleVersion</key>
	<string>0.0.1</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
